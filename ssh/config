# SSH configuration
# Identity files are managed by mainframe (fetched from password manager)

Host *
    AddKeysToAgent yes
    UseKeychain yes
    IdentitiesOnly yes

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

# Remote dev server
Host dev-mf
    HostName 100.84.203.95  # Tailscale IP
    Port 22
    User ubuntu
    IdentityFile ~/.ssh/dev-mf

# app-mf VPS
Host app-mf
    HostName 100.85.164.117
    Port 22
    User root
    IdentityFile ~/.ssh/app-mf

# data-mf VPS
Host data-mf
    HostName 185.176.252.134
    Port 22
    User root
    IdentityFile ~/.ssh/data-mf

# infra-mf VPS
Host infra-mf
    HostName 13.140.190.156
    Port 22
    User root
    IdentityFile ~/.ssh/infra-mf
