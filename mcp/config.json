{
  "mcp": {
    "servers": {
      "cve-now": {
        "type": "http",
        "url": "https://mcp.cve.now/mcp"
      },
      "cloudflare": {
        "type": "http",
        "url": "https://mcp.cloudflare.com/mcp"
      },
      "cloudflare-docs": {
        "type": "http",
        "url": "https://docs.mcp.cloudflare.com/mcp"
      },
      "browse": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome"]
      },
      "bitwarden": {
        "type": "stdio",
        "command": "mcp-server-bitwarden",
        "args": [],
        "env": {}
      },
      "web-fetch": {
        "type": "stdio",
        "command": "web-fetch",
        "args": [],
        "env": {}
      },
      "web-search": {
        "type": "stdio",
        "command": "web-search",
        "args": [],
        "env": {}
      }
    }
  }
}
