{
  "servers": {
    "ask-web-search-mcp": {
      "type": "stdio",
      "enabled": true,
      "description": "Web search via tinyfish/SearXNG backend",
      "secrets": [
        "ask-web-search-api-key"
      ],
      "install": "mcp/servers/ask-web-search-mcp/install.sh",
      "config": "mcp/servers/ask-web-search-mcp/config.json"
    },
    "bitwarden": {
      "type": "stdio",
      "enabled": true,
      "description": "Bitwarden password manager access",
      "secrets": [
        "bw-session"
      ],
      "install": "mcp/servers/bitwarden/install.sh",
      "config": "mcp/servers/bitwarden/config.json"
    },
    "browse": {
      "type": "stdio",
      "enabled": true,
      "description": "Browser automation via Chrome relay",
      "secrets": [],
      "install": "mcp/servers/browse/install.sh",
      "config": "mcp/servers/browse/config.json"
    },
    "web-fetch": {
      "type": "stdio",
      "enabled": true,
      "description": "Web fetch - reads any URL as clean Markdown (4-tier: content negotiation, trafilatura, curl_cffi, patchright)",
      "secrets": [],
      "install": "mcp/servers/web-fetch/install.sh",
      "config": "mcp/servers/web-fetch/config.json"
    }
  },
  "version": 1
}
