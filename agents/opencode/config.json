{
  "name": "opencode",
  "type": "cli",
  "install": {
    "macos": "curl -fsSL https://raw.githubusercontent.com/opencode-ai/opencode/refs/heads/main/install | bash",
    "linux": "curl -fsSL https://raw.githubusercontent.com/opencode-ai/opencode/refs/heads/main/install | bash"
  },
  "config_sync": {
    "mcp": "~/.config/opencode/mcp.json",
    "settings": "~/.config/opencode/config.json",
    "agents_md": "~/.config/opencode/AGENTS.md",
    "chats": "agents/opencode/chats/"
  },
  "secrets": [
    "opencode-api-key"
  ]
}
