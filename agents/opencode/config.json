{
  "name": "opencode",
  "type": "cli",
  "install": {
    "macos": "brew install opencode 2>/dev/null || npm install -g opencode",
    "linux": "npm install -g opencode"
  },
  "config_sync": {
    "mcp": "~/.config/opencode/mcp.json",
    "settings": "~/.config/opencode/config.json",
    "agents_md": "~/.config/opencode/AGENTS.md"
  },
  "secrets": [
    "opencode-api-key"
  ]
}
