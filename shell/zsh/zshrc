# Mainframe shell configuration
# Managed by mainframe - do not edit manually, edit in your mainframe repo

export ZSH=$DOTFILES/shell/zsh

# Source utils (defines prepend_path, etc.)
[[ -f "$DOTFILES/shell/zsh/utils.zsh" ]] && source "$DOTFILES/shell/zsh/utils.zsh"

# Prepend paths
prepend_path /opt/homebrew/bin
prepend_path /opt/homebrew/sbin
prepend_path /usr/local/bin
prepend_path $DOTFILES/bin
prepend_path $HOME/bin

# Code directory
if [[ -d ~/code ]]; then
    export CODE_DIR=~/code
fi

# Terminfo
if [ -z "$TMUX" ]; then
    [[ -f "$DOTFILES/resources/xterm-256color-italic.terminfo" ]] && tic "$DOTFILES/resources/xterm-256color-italic.terminfo" 2>/dev/null
    export TERM=xterm-256color-italic
else
    [[ -f "$DOTFILES/resources/tmux-256color-italic.terminfo" ]] && tic -x "$DOTFILES/resources/tmux-256color-italic.terminfo" 2>/dev/null
    export TERM=tmux-256color-italic
fi

# Autoload functions
if [[ -d $DOTFILES/shell/zsh/functions ]]; then
    fpath=($DOTFILES/shell/zsh/functions $fpath)
    for func in $DOTFILES/shell/zsh/functions/*(:t); do
        autoload -U "$func" 2>/dev/null
    done
fi

fpath=($fpath ~/.zsh/completion)

# Initialize completion
autoload -U compinit add-zsh-hook
compinit

# Configuration
export LC_ALL=en_US.UTF-8
export REPORTTIME=10

setopt NO_BG_NICE
setopt NO_HUP
setopt NO_LIST_BEEP
setopt LOCAL_OPTIONS
setopt LOCAL_TRAPS
setopt PROMPT_SUBST

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt EXTENDED_HISTORY
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt COMPLETE_ALIASES

# Keybindings
bindkey '^ ' forward-word
bindkey '^[^[[D' backward-word
bindkey '^[^[[C' forward-word
bindkey '^[[5D' beginning-of-line
bindkey '^[[5C' end-of-line
bindkey '^[[3~' delete-char
bindkey '^?' backward-delete-char

# Completion
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' insert-tab pending
zstyle ':completion:*' completer _expand _complete _files _correct _approximate

# Source prompt and utils
source "$DOTFILES/shell/zsh/prompt.zsh" 2>/dev/null
source "$DOTFILES/shell/zsh/utils.zsh" 2>/dev/null

# Source bash aliases
[[ -f "$DOTFILES/shell/bash/aliases" ]] && source "$DOTFILES/shell/bash/aliases"
for f in $DOTFILES/shell/bash/functions/*; do [[ -f "$f" ]] && source "$f"; done

# Plugins (zfetch)
export ZPLUGDIR="$CACHEDIR/zsh/plugins"
[[ -d "$ZPLUGDIR" ]] || mkdir -p "$ZPLUGDIR"
typeset -A plugins

if [[ -f "$DOTFILES/shell/zsh/functions/zfetch" ]]; then
    source "$DOTFILES/shell/zsh/functions/zfetch" 2>/dev/null
    zfetch $ZPLUGDIR zsh-users/zsh-syntax-highlighting 2>/dev/null
    zfetch $ZPLUGDIR zsh-users/zsh-autosuggestions 2>/dev/null
fi

# Local config (secrets, API keys, etc.)
[[ -f ~/.localrc ]] && source ~/.localrc

# FZF
[[ -f ~/.fzf.zsh ]] && source ~/.fzf.zsh
export FZF_DEFAULT_COMMAND='fd --type file --hidden --no-ignore 2>/dev/null || find . -type f'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Git aliases (hub → gh)
if command -v gh &>/dev/null; then
    eval "$(gh alias -s 2>/dev/null)" 2>/dev/null
fi

# Color for man pages
export MANROFFOPT='-c'
export LESS_TERMCAP_mb=$(tput bold; tput setaf 2)
export LESS_TERMCAP_md=$(tput bold; tput setaf 6)
export LESS_TERMCAP_me=$(tput sgr0)
export LESS_TERMCAP_so=$(tput bold; tput setaf 3; tput setab 4)
export LESS_TERMCAP_se=$(tput rmso; tput sgr0)
export LESS_TERMCAP_us=$(tput smul; tput bold; tput setaf 7)
export LESS_TERMCAP_ue=$(tput rmul; tput sgr0)

# Zoxide (better cd) - replaces z
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init zsh)"
fi

# Starship prompt (modern, fast)
if command -v starship &>/dev/null; then
    eval "$(starship init zsh)"
else
    source "$DOTFILES/shell/zsh/prompt.zsh" 2>/dev/null
fi

# Mise (replaces asdf, nvm, rbenv, pyenv)
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi

# Kitty config
export KITTY_CONFIG_DIRECTORY="$DOTFILES/terminal/kitty"

# Mycli pager
export LESS="-SRXF"

# Postgres defaults
export PGDATABASE=postgres
export PGUSER=postgres
export PGHOST=localhost

# Homebrew
export HOMEBREW_NO_AUTO_UPDATE=1

# FZF
export FZF_DEFAULT_COMMAND='fd --type file --hidden --no-ignore 2>/dev/null || find . -type f'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

# Path extensions
export PATH="$HOME/.yarn/bin:$HOME/.config/yarn/global/node_modules/.bin:$PATH"
export RIPGREP_CONFIG_PATH="$HOME/.rgrc"

# Vi mode
set -o vi
