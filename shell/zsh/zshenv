# Auto-detect mainframe directory
if [[ -z "$MAINFRAME_DIR" ]]; then
    for dir in "$HOME/.mainframe" "$HOME/mainframe" "$HOME/code/kaka-ruto/mainframe" "$HOME/Code/kaka-ruto/mainframe"; do
        if [[ -f "$dir/mainframe.yml" ]]; then
            MAINFRAME_DIR="$dir"
            break
        fi
    done
fi
export MAINFRAME_DIR

export DOTFILES="$MAINFRAME_DIR"
export CACHEDIR="$HOME/.local/share"
export INITVIM="$DOTFILES/editor/nvim/init.vim"

[[ -d "$CACHEDIR" ]] || mkdir -p "$CACHEDIR"

fpath=(
    $DOTFILES/shell/zsh/functions
    /usr/local/share/zsh/site-functions
    $fpath
)

typeset -aU path

export EDITOR='nvim'
export GIT_EDITOR='nvim'

# Source cargo env if available
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Source local bin env (uv, etc.)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# Source mise if available
if command -v mise &>/dev/null; then
    eval "$(mise activate zsh)"
fi
